# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Image Processing Configuration
# Options: realesrgan (default), mock (for testing without binary)
IMAGE_PROVIDER=realesrgan
REAL_ESRGAN_EXECUTABLE_PATH=./bin/realesrgan-ncnn-vulkan.exe
REAL_ESRGAN_MODELS_DIR=./bin/models

# Hardware Acceleration
# Options: auto (detects GPU, falls back to CPU), gpu, cpu
REAL_ESRGAN_DEVICE=auto
# Tile size for GPU processing (0 for auto, 200 or 400 for low VRAM)
REAL_ESRGAN_TILE_SIZE=200

# Limits & Upload Security
MAX_FILE_SIZE_MB=25
MAX_IMAGE_WIDTH=8192
MAX_IMAGE_HEIGHT=8192
ALLOWED_FORMATS=jpeg,png,webp
TEMP_DIR=./temp

# Optional Cloud Providers (future integration)
# CLOUD_AI_API_KEY=
